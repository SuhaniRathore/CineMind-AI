# Copy this file to `.env` and fill in real values locally.
# NEVER commit the actual `.env` file (see .gitignore) — see DEVELOPMENT_RULES.md, rule 13-14.

# --- General ---
APP_NAME="CineMind AI"
ENVIRONMENT=development
DEBUG=true

# --- Database (engine/session layer active from Milestone 2; tables added Milestone 3) ---
# For local non-Docker development:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cinemind
# For Docker development (uses the 'db' service name instead of localhost):
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/cinemind

# --- Auth (used starting Milestone 5 — not implemented yet) ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- TMDB API (used starting Milestone 4 — not connected to yet) ---
TMDB_API_KEY=replace-with-your-tmdb-api-key

# --- Milestone 12: Data Pipeline & ML Foundation ---
# Directory where raw dataset files are stored (MovieLens CSVs, etc.)
# In Docker this path is inside the container; mount a volume to persist it.
DATA_DIR=data
# Directory where serialized model artifacts are saved (e.g. trained SVD .pkl)
MODELS_DIR=data/models
# Secret token for /admin/* endpoints (not a JWT — just a bearer secret)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_SECRET=replace-with-a-long-random-admin-secret
# MovieLens variant: 'ml-latest-small' (recommended) or 'ml-latest'
MOVIELENS_VARIANT=ml-latest-small
# Minimum in-app ratings before collaborative filter activates (cold-start threshold)
COLLAB_MIN_RATINGS=3
# Hybrid blend weight for content-based score (0.0–1.0); collab = 1.0 - this
HYBRID_CONTENT_WEIGHT=0.4
