# LOCAL NON-DOCKER DEVELOPMENT
# If running the frontend via `npm run dev` (port 5173) and backend via `uvicorn` (port 8000)
# Uncomment the following line:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# DOCKER DEVELOPMENT / PRODUCTION
# If running via Docker Compose with Nginx reverse proxy, leave this file absent or empty.
# The build will naturally fallback to `/api/v1` and Nginx will proxy it correctly to the backend.
